	(text "This is an 4Gbit (512 MB) NAND flash chip - basically a solder-able SD card\n\nYou could replace it with an SD card connector, a larger-size NAND flash \nchip, or an eMMC (connected to SDC2 instead of SDC0). If using a different \nflash chip, just ensure the pinout is compatible and the protocol is SD2.0"
		(exclude_from_sim no)
		(at 147.32 121.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9840f8b0-7df8-440c-b914-a0b9fbe2c3af")
	)
	(text "This AND gate is used to disable the CLK signal\nwhen the FEL button is pressed. This allows for\nflashing firmware updates over USB"
		(exclude_from_sim no)
		(at 55.88 121.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b9850b6a-7f5c-4e53-82d1-14b279b5de51")
	)
